APP_NAME="ShopMini API"
DATABASE_URL=postgresql+psycopg://shopmini:shopmini_pass@localhost:5434/shopmini
CORS_ORIGINS=["http://localhost:5173","http://localhost:4173"]

# สร้างค่าใหม่ด้วยคำสั่ง: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=you_secret_key
ACCESS_TOKEN_EXPIRE_MINUTES=60
LOG_LEVEL=INFO
ENVIRONMENT=development
DOCS_ENABLED=true